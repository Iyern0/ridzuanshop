rules_version = '2';

// MINUM MALAM SISWA — Firestore security rules
// PASTE THIS INTO: Firebase Console → Firestore Database → Rules → Publish
//
// Threat model this closes:
//   * Before these rules, every path was "allow read, write: if true".
//     Anyone who opened the site URL could read every customer's name and
//     room number, delete order history, and rewrite the admin password.
//   * Now: the public can only CREATE a single well-formed order.
//     Reading, editing and deleting orders is admin-only.
//     Menu/config stay publicly readable (customers need them) but are
//     admin-only writable.

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user is an admin ONLY if it is the one specific account.
    //
    // Why not just "request.auth != null"? Because the Firebase web API key is
    // public (it ships in the HTML - that is normal for Firebase and is not a
    // secret). Once email/password sign-in is enabled, anybody can call
    // accounts:signUp against that key and mint themselves an account, which
    // would satisfy a bare auth check. Pinning the exact email closes that:
    // a squatter cannot claim an address that already exists, and everyone
    // else's freshly-registered account fails this test.
    //
    // CHANGE THIS if you ever change your admin address.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'zjasneh5@gmail.com';
    }

    // An order must look like an order. This caps field sizes so nobody can
    // use the orders collection as free storage or to inject junk into the
    // admin dashboard.
    function validOrder() {
      let d = request.resource.data;

      return d.keys().hasAll([
            'name', 'delivery', 'time', 'payment',
            'items', 'subtotal', 'total', 'status', 'createdAt', 'no'
          ])
          && d.keys().hasOnly([
            'name', 'room', 'delivery', 'time', 'payment',
            'items', 'subtotal', 'total', 'status', 'createdAt', 'phone', 'no',
            'coupon', 'free', 'freeItem'
          ])

          // who it is from
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 40

          // per-day order number, assigned from the counters/ document
          && d.no is int && d.no >= 1 && d.no <= 9999

          // optional WhatsApp number, used only for the loyalty stamp count
          // NOTE: use hasAny() - the `in` operator works on lists, not maps.
          && (!d.keys().hasAny(['phone'])
              || (d.phone is string && d.phone.size() <= 20))

          // where it goes — a COD order must name a block and room;
          // a pickup order carries no room at all.
          && d.delivery in ['cod', 'pickup']
          && (
               (d.delivery == 'cod'
                && d.room is string
                && d.room.size() >= 3
                && d.room.size() <= 40)
            || (d.delivery == 'pickup'
                && (!('room' in d)
                    || (d.room is string && d.room.size() <= 40)))
          )

          // when
          && d.time is string && d.time.size() >= 1 && d.time.size() <= 40

          // how they pay
          && d.payment in ['cash', 'qr', 'coupon']

          // A coupon order must name a real coupon that is still unused and
          // unexpired. The coupon is burned by the same transaction that writes
          // this order; rules cannot prove the burn happened, so the seller is
          // shown the code on the order and a coupon left unused is the audit
          // trail. Without this check, a crafted request could label any order
          // 'coupon' and pay nothing.
          // A coupon payment must name a coupon. Without the hasAll below, a
          // request carrying only `free` slipped through the first clause and
          // bought a free drink with no code at all.
          && (d.payment != 'coupon'
              || (d.keys().hasAll(['coupon'])
                  && d.coupon is string && d.coupon.size() == 8
                  && get(/databases/$(database)/documents/coupons/$(d.coupon)).data.used == false
                  && get(/databases/$(database)/documents/coupons/$(d.coupon)).data.exp > request.time))
          && (d.payment == 'coupon' || !d.keys().hasAny(['coupon', 'free', 'freeItem']))
          && (d.payment != 'coupon'
              || (d.keys().hasAll(['coupon', 'free'])
                  && d.free is number && d.free > 0 && d.free <= 100
                  && (!d.keys().hasAny(['freeItem'])
                      || (d.freeItem is string && d.freeItem.size() <= 60))))

          // what they bought
          && d.items is list && d.items.size() >= 1 && d.items.size() <= 50
          && d.subtotal is number && d.subtotal >= 0 && d.subtotal <= 1000

          // Every drink costs at least RM2.50, so a zero-value order is
          // never genuine. NOTE: rules cannot look up the price list, so the
          // client-supplied `total` is trusted. Someone can forge the AMOUNT
          // of an order (they still cannot forge that the order exists, read
          // the real history, or change an existing order). Payment is
          // settled in person, so a forged row is at worst a bogus line in
          // the admin queue. Closing this properly needs a trusted server
          // (Cloud Function), which costs money.
          && d.total is number && d.total <= 1100
          && (d.payment == 'coupon' ? d.total >= 0 : d.total > 0)

          // a customer may only ever create a brand new order
          && d.status == 'baru'

          // the customer cannot backdate or forge their own order time
          && d.createdAt == request.time;
    }

    // ------------------------------------------------------------------
    // Orders: write-once by the public, managed exclusively by the admin.
    // ------------------------------------------------------------------
    match /orders/{orderId} {
      allow create: if validOrder();
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Daily order counter, one document per calendar day: counters/2026-10-14
    //
    // The customer's browser increments this inside a transaction and stamps
    // the resulting number onto their order, so numbering runs 001, 002, ...
    // and resets naturally at midnight (a new day is simply a new document).
    //
    // Rules make it strictly monotonic: it can be created at 1 and only ever
    // go UP by exactly one. It can never be reset, decremented or jumped.
    // Somebody could still burn numbers by calling the counter without
    // ordering, which is a cosmetic nuisance, not a leak or a takeover.
    // ------------------------------------------------------------------
    match /counters/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n'])
                   && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
                   && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // Public order tracking, keyed by the customer's secret 6-char code.
    //
    // Deliberately does NOT live on the order document: that would mean making
    // the order world-readable to let a customer watch their own status. This
    // carries status only - no name, no room, no items.
    //
    // A customer may create their own entry (status locked to 'baru'), but
    // only the admin may ever change it.
    // ------------------------------------------------------------------
    match /tracking/{code} {
      // The customer reads their own order by the code they were given, and
      // that is the only read that exists. Listing the collection would hand
      // out every order at once - and, since the mint parks a coupon code here
      // for the customer to find, every coupon with it.
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['status', 'no', 'at'])
                   && request.resource.data.status == 'baru';
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Payment proof: a customer attaches their DuitNow/TNG receipt screenshot
    // to their own order, plus an optional transaction reference.
    //
    // Lives here rather than on tracking/{code} because tracking is world-
    // readable - a bank receipt must never be. Only the seller can read these,
    // and they are keyed by the order code so they cannot be listed by anyone
    // else either.
    //
    // The customer may only ever CREATE their own entry, never read it back,
    // never change it and never remove it. The payload is closed to exactly
    // one inline file and a timestamp, and it is capped so this cannot be used
    // as free storage.
    //
    // A floor as well as a ceiling: the client refuses to submit without a
    // file, and this stops anyone bypassing that by posting a stub, which
    // would otherwise raise an alert at the seller with nothing to look at.
    //
    // PDF sits alongside the image formats because a DuitNow/TNG receipt is
    // often saved as a PDF. Note the practical ceiling: Firestore caps a
    // document at 1 MiB and base64 inflates by a third, so the 700000
    // character cap below works out at roughly half a megabyte of PDF. The
    // client refuses anything larger up front and says so.
    // ------------------------------------------------------------------
    match /payments/{code} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys()
                     .hasOnly(['img', 'at'])
                   && request.resource.data.at == request.time
                   && request.resource.data.img is string
                   && request.resource.data.img.size() >= 2000
                   && request.resource.data.img.size() <= 700000
                   && (request.resource.data.img.matches(
                         '^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')
                       || request.resource.data.img.matches(
                         '^data:application/pdf;base64,[A-Za-z0-9+/=]+$'));
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Loyalty members, keyed by phone number.
    //
    // Created by the customer from the stamp prompt on the done screen, and
    // readable ONLY by the seller.
    //
    // Deliberately not publicly readable. A lookup keyed by phone number can
    // be enumerated - a Malaysian mobile is ten digits and guessable - so a
    // public read here would let anyone work out which numbers belong to
    // customers. That is the same class of leak this whole file exists to
    // prevent, and it is why the customer's OWN stamp progress stays on their
    // own device rather than being looked up from here.
    //
    // Create only: nothing may edit or delete a member from a browser. The
    // document id is pinned to the number inside it so the two cannot
    // disagree, and a name is required so a record is never a bare digit
    // string with nobody attached.
    //
    // NOTE: this block does nothing until it is published. Until then the
    // write is refused, the app treats that refusal as normal, and the
    // customer's number still lives on their device and still rides on their
    // next order.
    // ------------------------------------------------------------------
    // ------------------------------------------------------------------
    // Free-drink coupons. Minted by the seller when a customer completes
    // their fifth order: one drink free, valid 30 days, one use.
    //
    // The code IS the document id and it is the only credential - 8 chars
    // from a 32-character alphabet (40 bits), with LIST denied so the
    // collection cannot be enumerated. The document carries no name, no
    // phone and no items, so reading one tells you nothing about anybody.
    //
    // Single use is a rule, not a promise. "used" may only go false -> true
    // and nothing else may change, so a second device holding the same code
    // loses the race: Firestore serialises the update and the loser no
    // longer sees used == false.
    //
    // The seller may also write freely, because minting happens from the
    // admin panel - there are no Cloud Functions in this project.
    // ------------------------------------------------------------------
    match /coupons/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if (resource.data.used == false
                    && resource.data.exp is timestamp
                    && resource.data.exp > request.time
                    && request.resource.data.used == true
                    && request.resource.data.usedAt is timestamp
                    && request.resource.data.usedAt >= request.time - duration.value(1, 'm')
                    && request.resource.data.ord is string
                    && request.resource.data.ord.size() == 6
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['used', 'usedAt', 'ord']))
                   || isAdmin();
    }

    // One marker per (phone, milestone). It exists to stop a double tap on
    // "Siap" minting two coupons for the same fifth order, so it is the
    // seller's business in every direction and nobody else's.
    match /milestones/{key} {
      allow read, create, update, delete: if isAdmin();
    }

    match /members/{phone} {
      allow create: if request.resource.data.keys().hasOnly(['phone', 'name', 'at'])
                   && request.resource.data.at == request.time
                   && request.resource.data.phone is string
                   && request.resource.data.phone.size() >= 8
                   && request.resource.data.phone.size() <= 20
                   && request.resource.data.phone == phone
                   && request.resource.data.name is string
                   && request.resource.data.name.size() >= 2
                   && request.resource.data.name.size() <= 40;
      allow read, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Funnel analytics. Anonymous step counters.
    //
    //   * anyone may append an event (that is how we count anonymous
    //     visitors at all - they are not signed in)
    //   * only the admin may read them back
    //   * nobody may EDIT history - that would let somebody quietly edit
    //     the numbers rather than having to inject fake events
    //   * the admin may DELETE, because the counts are only meaningful if
    //     the owner can clear them. This is their own traffic data and
    //     self-service deletion beats asking someone else for a console.
    //
    // The field list is closed, so this collection cannot be used as free
    // storage. A determined person could inflate the counts; that costs us
    // nothing and is far preferable to requiring a login for the menu.
    // ------------------------------------------------------------------
    function validEvent() {
      let d = request.resource.data;
      return d.keys().hasAll(['step', 'at', 'sid'])
          && d.keys().hasOnly(['step', 'at', 'sid'])
          && d.step in ['page_view', 'menu_view', 'item_open',
                        'add_cart', 'checkout_open', 'order_sent', 'order_fail']
          && d.sid is string && d.sid.size() >= 6 && d.sid.size() <= 40
          && d.at == request.time;
    }

    match /events/{eventId} {
      allow create: if validEvent();
      allow read: if isAdmin();
      allow update: if false;
      // Self-service reset from the admin panel. Admin-only, so this widens
      // the blast radius to exactly the one account that already owns this
      // data.
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Menu / config: world-readable so the storefront works without login,
    // admin-only writable so nobody can silently alter the menu or prices.
    // ------------------------------------------------------------------
    match /settings/{docId} {
      allow read: if docId != 'admin';
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Everything else is sealed. (Firestore allows a request if ANY matching
    // rule allows it, so this is the safety net behind the rules above.)
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}